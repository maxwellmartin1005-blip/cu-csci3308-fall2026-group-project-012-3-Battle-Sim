<main class="home-page" aria-labelledby="home-title">
    <div class="home-page__toolbar">
        <form action="/logout" method="POST">
            <button type="submit">Log out</button>
        </form>
    </div>

    <section class="home-page__welcome">
        <h2 id="home-title">Welcome, {{username}}!</h2>
        <form action="/characterSelect" method="GET">
            <button class="home-page__play" type="submit">Play</button>
        </form>
    </section>
</main>
