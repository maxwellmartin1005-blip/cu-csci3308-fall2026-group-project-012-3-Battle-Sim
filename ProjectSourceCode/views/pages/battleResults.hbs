<main class="battle-results column-container">
    <p class="text-muted">Sample result</p>
    <h2 class="mb-3">{{#if isVictory}}You win!{{else}}You lose{{/if}}</h2>

    <div class="battle-results__portrait mx-auto mb-3 d-flex align-items-center justify-content-center"
         role="img" aria-label="{{winner}} image placeholder">
        Image placeholder
    </div>

    <p><strong>{{winner}}</strong> wins.</p>
    <p>{{loser}} was defeated.</p>
    <form class="battle-results__actions" action="/characterSelect" method="GET">
        <button type="submit">Choose fighter</button>
    </form>
</main>
