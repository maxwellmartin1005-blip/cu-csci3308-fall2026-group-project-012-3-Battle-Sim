<div class="character-select-body">
    <div class="row-container">
        <p>Choose Fighter</p>
        <button>Add new fighter</button>
    </div>

    <div class="row-container">
        <div class="fighter-card">
            <img src="https://th.bing.com/th/id/OIP.Quml2zTToVc0brg_gIW_FwHaGX?w=205&h=180&c=7&r=0&o=7&dpr=1.3&pid=1.7&rm=3" alt="Uganda Knuckles">
            <p>Uganda Knuckles</p>
            <p class="hidden-text">Selected</p>
        </div>

        <div class="fighter-card">
            <img src="https://th.bing.com/th/id/OIP.Quml2zTToVc0brg_gIW_FwHaGX?w=205&h=180&c=7&r=0&o=7&dpr=1.3&pid=1.7&rm=3" alt="Uganda Knuckles">
            <p>Uganda Knuckles</p>
            <p class="hidden-text">Selected</p>
        </div>

        <div class="fighter-card">
            <img src="https://th.bing.com/th/id/OIP.Quml2zTToVc0brg_gIW_FwHaGX?w=205&h=180&c=7&r=0&o=7&dpr=1.3&pid=1.7&rm=3" alt="Uganda Knuckles">
            <p>Uganda Knuckles</p>
            <p class="hidden-text">Selected</p>
        </div>
    </div>

    <div class="column-container">
        <p>Quick Hit - Light Damage</p>
        <p>Heavy Hit - More Damage</p>
        <p>Guard - Reduce next hit</p>
    </div>

    <a href="/battle"><button id="battle-btn">Battle</button></a>
</div>

<script>
    // Get all clickable divs and text divs
    const clickableDivs = document.querySelectorAll('.fighter-card');
    const textDivs = document.querySelectorAll('.hidden-text');

    clickableDivs.forEach((div, index) => {
        div.addEventListener('click', () => {
            // Hide all text divs first
            textDivs.forEach(text => text.classList.remove('visible'));

            // Show only the clicked div's text
            textDivs[index].classList.add('visible');

            const battleBtn = document.getElementById('battle-btn');
            battleBtn.style.display = 'block';
        });
    });
</script>