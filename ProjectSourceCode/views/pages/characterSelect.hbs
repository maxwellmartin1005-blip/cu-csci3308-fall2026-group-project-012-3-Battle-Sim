<div class="character-select-body">
    <div class="row-container">
        <p>Choose Fighter</p>
        <a href="/createFighter"><button>Add new fighter</button></a>
    </div>

    <div class="row-container">
        {{#each fighters}}
        <div class="fighter-card" data-id="{{this.id}}">
            <p>{{this.name}}</p>
            <p>{{this.element}}</p>
            <p class="hidden-text">Selected</p>
        </div>
        {{/each}}
    </div>

    <a id="battle-link" href="/battle"><button id="battle-btn">Start Battle</button></a>
</div>

<script>
    const clickableDivs = document.querySelectorAll('.fighter-card');
    const textDivs = document.querySelectorAll('.hidden-text');
    const battleBtn = document.getElementById('battle-btn');
    const battleLink = document.getElementById('battle-link');

    clickableDivs.forEach((div, index) => {
        div.addEventListener('click', () => {
            textDivs.forEach(text => text.classList.remove('visible'));
            textDivs[index].classList.add('visible');

            battleBtn.style.display = 'block';
            battleLink.href = '/battle?fighterId=' + div.dataset.id;
        });
    });
</script>