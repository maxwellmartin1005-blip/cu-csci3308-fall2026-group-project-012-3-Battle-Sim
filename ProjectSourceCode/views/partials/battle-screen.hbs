<style>
    .battle-screen {
        box-sizing: border-box;
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        padding: 24px 16px;
        color: #1f2937;
        font-family: system-ui, sans-serif;
    }

    .battle-screen *,
    .battle-screen *::before,
    .battle-screen *::after {
        box-sizing: border-box;
    }

    .battle-screen__heading {
        margin: 0 0 8px;
    }

    .battle-screen__note {
        margin: 0 0 24px;
        color: #4b5563;
    }

    .battle-screen__fighters {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .battle-screen__fighter {
        min-width: 0;
        padding: 20px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
    }

    .battle-screen__fighter h3 {
        margin: 4px 0 16px;
    }

    .battle-screen__role {
        margin: 0;
        color: #4b5563;
    }

    .battle-screen__portrait {
        display: grid;
        place-items: center;
        width: 100%;
        max-width: 180px;
        aspect-ratio: 1;
        margin: 0 auto 20px;
        padding: 12px;
        border: 2px dashed #94a3b8;
        background: #f1f5f9;
        text-align: center;
    }

    .battle-screen__health-label {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 8px;
    }

    .battle-screen__health {
        width: 100%;
        height: 24px;
    }

    .battle-screen__moves {
        min-width: 0;
        margin: 24px 0 0;
        padding: 0;
        border: 0;
    }

    .battle-screen__moves legend {
        margin-bottom: 8px;
        padding: 0;
        font-size: 18px;
        font-weight: 700;
    }

    .battle-screen__move-buttons {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .battle-screen__move {
        min-height: 48px;
        padding: 12px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        background: #e2e8f0;
        color: #475569;
        font: inherit;
        opacity: 1;
        cursor: not-allowed;
    }

    @media (max-width: 600px) {
        .battle-screen__fighters,
        .battle-screen__move-buttons {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="battle-screen" aria-labelledby="battle-screen-title">
    <h2 class="battle-screen__heading" id="battle-screen-title">Battle</h2>
    <p class="battle-screen__note">Placeholder preview: sample fighters and health.</p>

    <div class="battle-screen__fighters">
        <article class="battle-screen__fighter" aria-labelledby="battle-fighter-a">
            <p class="battle-screen__role">You</p>
            <h3 id="battle-fighter-a">Fighter A</h3>
            <div class="battle-screen__portrait" role="img" aria-label="Fighter A image placeholder">
                Image placeholder
            </div>
            <label class="battle-screen__health-label" for="battle-health-a">
                <span>Health</span>
                <span>75 / 100 HP</span>
            </label>
            <meter class="battle-screen__health" id="battle-health-a" min="0" max="100" value="75">
                75 out of 100 health points
            </meter>
        </article>

        <article class="battle-screen__fighter" aria-labelledby="battle-fighter-b">
            <p class="battle-screen__role">Opponent</p>
            <h3 id="battle-fighter-b">Fighter B</h3>
            <div class="battle-screen__portrait" role="img" aria-label="Fighter B image placeholder">
                Image placeholder
            </div>
            <label class="battle-screen__health-label" for="battle-health-b">
                <span>Health</span>
                <span>60 / 100 HP</span>
            </label>
            <meter class="battle-screen__health" id="battle-health-b" min="0" max="100" value="60">
                60 out of 100 health points
            </meter>
        </article>
    </div>

    <fieldset class="battle-screen__moves" disabled aria-describedby="battle-moves-note">
        <legend>Sample moves</legend>
        <p class="battle-screen__note" id="battle-moves-note">
            Preview only: these move buttons do not start a turn.
        </p>
        <div class="battle-screen__move-buttons">
            <button class="battle-screen__move" type="button">Quick hit</button>
            <button class="battle-screen__move" type="button">Heavy hit</button>
            <button class="battle-screen__move" type="button">Guard</button>
        </div>
    </fieldset>
</section>
